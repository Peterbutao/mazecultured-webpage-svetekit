              </a>
              <a href="https://spotify.com" target="_blank" rel="noopener" class="social-icon-btn" aria-label="Spotify">
                <svg viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.899 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.019zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141 C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.18-.1.2-.24-.42-.18-.6.2-1.2.8-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
              </a>
            </div>
          </div>
          <div class="about-grid-stats">
            <div class="stat-box">
              <div class="stat-title">URBAN NODES</div>
              <div class="stat-val">BT // LL // MZ // ZB</div>
            </div>
            <div class="stat-box">
              <div class="stat-title">ARCHIVE TYPE</div>
              <div class="stat-val">NON-LINEAR GRID</div>
            </div>
            <div class="stat-box">
              <div class="stat-title">PRIMARY FOCUS</div>
              <div class="stat-val">YOUTH MOVEMENT</div>
            </div>
            <div class="stat-box">
              <div class="stat-title">CURATION</div>
              <div class="stat-val">GROUND LEVEL</div>
            </div>
          </div>
        </div>

        <div>
          <button class="turn-btn" data-stage="2">
            <span>ENTER CORRIDOR 02: SOUND & IDENTITY</span>
            <span>↓</span>
          </button>
          <div class="hazard-bar"></div>
        </div>
      </section>

      <!-- 03: ABALE -->
      <section class="panel" id="abale">
        <div>
          <div class="corridor-tag">CORRIDOR 02 // SOUND & IDENTITY</div>
          <h1>ABALE:<br /><span class="highlight-red">THE MOVEMENT.</span></h1>
        </div>
        <Carousel slides={abaleSlides} client:visible />
        <div>
          <button class="turn-btn" data-stage="3">
            <span>TURN RIGHT: DAPP FASHION</span>
            <span>→</span>
          </button>
          <div class="hazard-bar"></div>
        </div>
      </section>

      <!-- 04: JEZE -->
      <section class="panel" id="jeze">
        <div>
          <div class="corridor-tag">CORRIDOR 03 // FOOTBALL × STREETWEAR</div>
          <h1>JEZE:<br /><span class="highlight-cyan">DAPP FIT.</span></h1>
        </div>
        <Carousel slides={jezeSlides} client:visible />
        <div>
          <button class="turn-btn alt" data-stage="4">
            <span>SCROLL DOWN: CAR CULTURE</span>
            <span>↓</span>
          </button>
          <div class="hazard-bar"></div>
        </div>
      </section>

      <!-- 05: GOLF -->
      <section class="panel" id="golf">
        <div>
          <div class="corridor-tag">CORRIDOR 04 // CAR CULTURE</div>
          <h1>THE GOLF<br /><span class="highlight-yellow">SERIES.</span></h1>
        </div>
        <Carousel slides={golfSlides} client:visible />
        <div>
          <button class="turn-btn" data-stage="5">
            <span>PROCEED TO EXIT & MAP</span>
            <span>↓</span>
          </button>
          <div class="hazard-bar"></div>
        </div>
      </section>

      <!-- 06: FOOTER -->
      <section class="panel" id="footer">
        <div>
          <div class="corridor-tag">CORRIDOR 05 // EXIT & FULL ARCHIVE</div>
          <h1>MAZE.<br /><span class="highlight-yellow">CULTRD.</span></h1>
        </div>

        <div class="footer-content">
          <div class="footer-ticker">
            <div class="ticker-track">
              /// BLANTYRE /// LILONGWE /// MZUZU /// ZOMBA /// MAZE.CULTRD /// STREET ARCHIVE /// URBAN SUBCULTURES /// DAPP GRAILS /// CAR CULTURE /// ABALE MOVEMENT ///
              /// BLANTYRE /// LILONGWE /// MZUZU /// ZOMBA /// MAZE.CULTRD /// STREET ARCHIVE /// URBAN SUBCULTURES /// DAPP GRAILS /// CAR CULTURE /// ABALE MOVEMENT ///
            </div>
          </div>

          <div class="footer-grid">
            <div class="footer-col">
              <h4>SECTORS</h4>
              <ul class="footer-links">
                <li><a href="#" data-stage="2">Abale Soundscapes <span>↗</span></a></li>
                <li><a href="#" data-stage="3">Jeze Dapp Fits <span>↗</span></a></li>
                <li><a href="#" data-stage="4">VW Golf Culture <span>↗</span></a></li>
                <li><a href="#">Nightlife Archive <span>↗</span></a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h4>CONNECT</h4>
              <ul class="footer-links">
                <li><a href="https://instagram.com" target="_blank" rel="noopener">Instagram <span>↗</span></a></li>
                <li><a href="https://audiomack.com" target="_blank" rel="noopener">Audiomack <span>↗</span></a></li>
                <li><a href="https://youtube.com" target="_blank" rel="noopener">YouTube <span>↗</span></a></li>
                <li><a href="https://tiktok.com" target="_blank" rel="noopener">TikTok <span>↗</span></a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h4>SUBMISSIONS</h4>
              <p class="footer-sub-text">Have photography, articles, or zines documenting Malawian subcultures? Submit your work to our underground editorial team.</p>
            </div>
            <div class="footer-col">
              <h4>LABYRINTH MAP</h4>
              <p class="footer-sub-text">MAZE.CULTRD operates as a non-linear 2D spatial grid. Every scroll represents a corner turned in the urban archive.</p>
            </div>
          </div>

          <div class="city-nodes-bar">BLANTYRE // LILONGWE // MZUZU // ZOMBA</div>

          <div class="copyright-line">
            <span>© 2026 MAZE.CULTRD // ALL RIGHTS RESERVED</span>
            <span>MALAWIAN SUBCULTURES & STREET ARCHIVE</span>
          </div>
        </div>

        <div>
          <button class="turn-btn alt" data-stage="0">
            <span>RETURN TO MAZE MOUTH</span>
            <span>↺</span>
          </button>
          <div class="hazard-bar"></div>
        </div>
      </section>
    </main>
  </div>

  <script>
    // 2D Maze navigation — ported from original index.html, now as Astro client script
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      const world = document.getElementById('maze-world');
      const scrollTotal = 6000;
      document.body.style.height = `${scrollTotal}px`;

      let currentX = 0, currentY = 0;
      let targetX = 0, targetY = 0;
      const ease = 0.12;

      function mazeLoop() {
        const scrollY = window.scrollY;
        const maxScroll = scrollTotal - window.innerHeight;
        const progress = Math.min(Math.max(maxScroll > 0 ? scrollY / maxScroll : 0, 0), 1);

        if (progress <= 0.20) {
          const p = progress / 0.20;
          targetX = 0;
          targetY = p * 100;
        } else if (progress <= 0.40) {
          const p = (progress - 0.20) / 0.20;
          targetX = 0;
          targetY = 100 + (p * 100);
        } else if (progress <= 0.60) {
          const p = (progress - 0.40) / 0.20;
          targetX = p * 100;
          targetY = 200;
        } else if (progress <= 0.80) {
          const p = (progress - 0.60) / 0.20;
          targetX = 100;
          targetY = 200 + (p * 100);
        } else {
          const p = (progress - 0.80) / 0.20;
          targetX = 100;
          targetY = 300 + (p * 100);
        }

        currentX += (targetX - currentX) * ease;
        currentY += (targetY - currentY) * ease;

        if (world) world.style.transform = `translate3d(-${currentX.toFixed(2)}vw, -${currentY.toFixed(2)}vh, 0)`;

        requestAnimationFrame(mazeLoop);
      }
      requestAnimationFrame(mazeLoop);

      function scrollToStage(stage) {
        const maxScroll = scrollTotal - window.innerHeight;
        let targetProgress = 0;
        if (stage === 1) targetProgress = 0.20;
        if (stage === 2) targetProgress = 0.40;
        if (stage === 3) targetProgress = 0.60;
        if (stage === 4) targetProgress = 0.80;
        if (stage === 5) targetProgress = 1.00;
        window.scrollTo({ top: targetProgress * maxScroll, behavior: 'smooth' });
      }

      // expose globally for any inline handlers
      window.scrollToStage = scrollToStage;

      // delegate [data-stage] clicks
      document.addEventListener('click', (e) => {
        const el = (e.target instanceof HTMLElement ? e.target.closest('[data-stage]') : null);
        if (!el) return;
        const stage = parseInt(el.getAttribute('data-stage') || '', 10);
        if (Number.isNaN(stage)) return;
        e.preventDefault();
        scrollToStage(stage);
      });
    }
  </script>
</Layout>
