---
import Layout from '../layouts/Layout.astro';
import NavMenu from '../components/NavMenu.svelte';
import Carousel from '../components/Carousel.svelte';

const heroSlides = [
  { bgClass: 'bg-e1', sticker: 'SECTOR 01', title: 'BLANTYRE TO LILONGWE', punchline: 'Music movements, car culture, and street style documented at ground level.' },
  { bgClass: 'bg-e2', sticker: 'MANIFESTO', title: 'NOT A BLOG FEED', punchline: 'Navigate through connected corridors. Every scroll turns a corner.' },
  { bgClass: 'bg-e3', sticker: 'ORIENTATION', title: 'SCROLL TO PAN', punchline: 'Move down into the depth of the maze to unlock adjacent threads.' },
];
const abaleSlides = [
  { bgClass: 'bg-a1', sticker: 'ABALE // 49', title: "CRISPY'S RETURN", punchline: '"The music created the language. The language created the identity."' },
  { bgClass: 'bg-a2', sticker: 'ABALE // 54', title: 'WAREHOUSE SHOWS', punchline: 'Reclaiming local street slang into a living generation\'s uniform.' },
  { bgClass: 'bg-a3', sticker: 'ABALE // 73', title: 'STREET ARCHIVE', punchline: 'Documenting the underground youth movement in real-time.' },
];
const jezeSlides = [
  { bgClass: 'bg-j1', sticker: 'JEZE // DSC9179', title: 'EUROPEAN CAST-OFFS', punchline: '90s football jerseys re-contextualized into urban high fashion.' },
  { bgClass: 'bg-j2', sticker: 'KUMBALI LIVE', title: 'HEAVY BOOTS & DENIM', punchline: 'Worn not for the club badge, but purely for the street aesthetic.' },
  { bgClass: 'bg-j3', sticker: 'JEZE 3 // 12', title: 'SECOND-HAND GRAILS', punchline: 'Thrifting culture giving second life to global sporting history.' },
];
const golfSlides = [
  { bgClass: 'bg-g1', sticker: 'LMS // 03', title: 'BLANTYRE DRIFT', punchline: 'F1 fandom meets local VW customization. Exhaust notes off concrete.' },
  { bgClass: 'bg-g2', sticker: 'LMS // 13', title: 'REWRITING MAPS', punchline: 'Custom rims and lowered suspensions as a statement of presence.' },
  { bgClass: 'bg-g3', sticker: 'LMS // 50', title: 'THE VW E30 LEGACY', punchline: 'Is the Golf series to Malawi what the BMW E30 is to South Africa?' },
];
---

<Layout>
  <header>
    <div class="header-left">
      <div class="brand">MAZE.CULTRD</div>
      <div class="street-tag">MW // SUBCULTURES</div>
    </div>
    <NavMenu client:load />
  </header>

  <div id="viewport">
    <main id="maze-world">
      <!-- 01: HERO -->
      <section class="panel" id="hero">
        <div>
          <div class="corridor-tag">CORRIDOR 01 // ENTRY</div>
          <h1>CULTURAL<br /><span class="highlight-yellow">LABYRINTH.</span></h1>
        </div>
        
        <Carousel slides={heroSlides} client:visible />
        <div class="hero-actions">
          <a href="/projects" class="turn-btn hero-action-btn" aria-label="View Projects">
            <span>PROJECTS</span>
            <span>→</span>
          </a>
          <a href="/articles" class="turn-btn alt hero-action-btn" aria-label="View Articles">
            <span>ARTICLES</span>
            <span>→</span>
          </a>
        </div>
        <br />

        <div>
          <button class="turn-btn" data-stage="1">
            <span>ABOUT MAZE</span>
            <span>↓</span>
          </button>
          <div class="hazard-bar"></div>
          <br/>
        </div>
      </section>
      

      <!-- 02: ABOUT -->
      <section class="panel" id="about">
        <div>
          <div class="corridor-tag">CORRIDOR 01.5 // ARCHIVE MISSION</div>
          <h1>UNSEEN<br /><span class="highlight-cyan">SUBCULTURES.</span></h1>
